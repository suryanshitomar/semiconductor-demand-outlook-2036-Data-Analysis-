{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "markettrend",
  "position": {
    "x": 20,
    "y": 20,
    "z": 0,
    "width": 1240,
    "height": 350,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "market"
                    }
                  },
                  "Property": "year"
                }
              },
              "queryRef": "market.year",
              "displayName": "year"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "market"
                    }
                  },
                  "Property": "Market sales USD bn"
                }
              },
              "queryRef": "market.Market sales USD bn"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Selected reported global sales · USD billions · mixed vintages'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
